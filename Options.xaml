<ResourceDictionary
    x:Class="NINA.Plugin.CanonAstroImage.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.CanonAstroImage">

    <!-- Shown in NINA's Options > Plugins tab. The key MUST match the AssemblyTitle: "Canon Astro Image" + "_Options" -->
    <DataTemplate x:Key="Canon Astro Image_Options">
        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock
                Text="Canon Astro Image"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{DynamicResource PrimaryBrush}"
                Margin="0,0,0,10" />

            <!-- Plugin enable/disable -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <CheckBox
                    x:Name="PluginEnabledToggle"
                    IsChecked="{Binding PluginEnabled, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
                <TextBlock
                    Text="Enable Plugin"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryBrush}" />
            </StackPanel>

            <!-- Auto-delete (disabled when the plugin is disabled) -->
            <StackPanel
                Orientation="Horizontal"
                Margin="0,0,0,15"
                IsEnabled="{Binding PluginEnabled}">
                <CheckBox
                    x:Name="AutoDeleteToggle"
                    IsChecked="{Binding AutoDeleteCanonRaw, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
                <TextBlock
                    Text="Auto-Delete Canon RAW Files (CR3/CR2)"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource PrimaryBrush}" />
            </StackPanel>

            <!-- Description -->
            <TextBlock
                Text="Saves each Canon capture in the format selected under Options -> Imaging -> File Settings (FITS, XISF or TIFF). With auto-delete off you get both the converted file and the CR3/CR2. With auto-delete on, NINA saves only the selected format and no RAW file is written."
                Foreground="{DynamicResource PrimaryBrush}"
                Opacity="0.75"
                FontSize="11"
                TextWrapping="Wrap"
                Margin="0,0,0,10" />

            <!-- Permanent-deletion warning -->
            <Border
                Background="{DynamicResource NotificationWarningBrush}"
                BorderBrush="{DynamicResource NotificationWarningBrush}"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10"
                CornerRadius="3"
                IsEnabled="{Binding PluginEnabled}">
                <TextBlock
                    Text="⚠ With auto-delete on, no CR3/CR2 file is kept. Leave it off if you need the original Canon RAW files."
                    Foreground="{DynamicResource NotificationWarningTextBrush}"
                    FontSize="11"
                    TextWrapping="Wrap" />
            </Border>

            <!-- How it works. No fill: PrimaryBrush text is only guaranteed readable on the page background in every theme. -->
            <Border
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="10"
                CornerRadius="3">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        Text="How it works"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        FontSize="11"
                        Margin="0,0,0,5" />
                    <TextBlock
                        Text="1. Enable this plugin&#10;2. Choose FITS, XISF or TIFF under Options -> Imaging -> File Settings&#10;3. Take an exposure with your Canon camera&#10;4. Auto-delete off: the plugin writes the converted file and NINA writes the CR3/CR2&#10;5. Auto-delete on: NINA writes only the converted file - one write per frame, nothing to delete"
                        Foreground="{DynamicResource PrimaryBrush}"
                        FontSize="10"
                        TextWrapping="Wrap"
                        LineHeight="16" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>

<ResourceDictionary
    x:Class="NINA.Plugin.CanonAstroImage.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.CanonAstroImage">

    <!-- Shown in NINA's Options > Plugins tab. The key MUST match the AssemblyTitle: "Canon Astro Image" + "_Options" -->
    <DataTemplate x:Key="Canon Astro Image_Options">
        <StackPanel Orientation="Vertical" Margin="10">
            <TextBlock
                Text="Canon Astro Image"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{DynamicResource PrimaryBrush}"
                Margin="0,0,0,10" />

            <!-- Plugin enable/disable -->
            <StackPanel
                Orientation="Horizontal"
                Margin="0,0,0,15"
                Background="Transparent"
                ToolTip="Save frames from Canon cameras connected through NINA's native Canon driver in the format chosen under Options -> Imaging -> File Settings. When off, NINA saves Canon frames as CR3/CR2 only. Other cameras are never affected.">
                <CheckBox
                    x:Name="PluginEnabledToggle"
                    IsChecked="{Binding PluginEnabled, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
                <TextBlock
                    Text="Enable Plugin"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryBrush}" />
            </StackPanel>

            <!-- Also save the Canon RAW file (disabled when the plugin is disabled) -->
            <StackPanel
                Orientation="Horizontal"
                Margin="0,0,0,15"
                Background="Transparent"
                IsEnabled="{Binding PluginEnabled}"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="On: each frame is saved twice - in your selected format and as Canon's original CR3/CR2 file. Off: NINA saves only the selected format, in a single write per frame (faster, less disk space).">
                <CheckBox
                    x:Name="SaveCanonRawToggle"
                    IsChecked="{Binding SaveCanonRaw, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
                <TextBlock
                    Text="Also save Canon RAW file (CR3/CR2)"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource PrimaryBrush}" />
            </StackPanel>

            <!-- Description -->
            <TextBlock
                Text="Saves each Canon capture in the format selected under Options -> Imaging -> File Settings (FITS, XISF or TIFF). Turn on &quot;Also save Canon RAW file&quot; to keep Canon's original CR3/CR2 next to it."
                Foreground="{DynamicResource PrimaryBrush}"
                Opacity="0.75"
                FontSize="11"
                TextWrapping="Wrap"
                Margin="0,0,0,10" />

            <!-- No-RAW notice -->
            <Border
                Background="{DynamicResource NotificationWarningBrush}"
                BorderBrush="{DynamicResource NotificationWarningBrush}"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10"
                CornerRadius="3"
                IsEnabled="{Binding PluginEnabled}">
                <TextBlock
                    Text="⚠ When &quot;Also save Canon RAW file&quot; is off, no CR3/CR2 is written: the FITS/XISF/TIFF file is the only copy of each frame."
                    Foreground="{DynamicResource NotificationWarningTextBrush}"
                    FontSize="11"
                    TextWrapping="Wrap" />
            </Border>

            <!-- How it works. No fill: PrimaryBrush text is only guaranteed readable on the page background in every theme. -->
            <Border
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="10"
                CornerRadius="3">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        Text="How it works"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryBrush}"
                        FontSize="11"
                        Margin="0,0,0,5" />
                    <TextBlock
                        Text="1. Enable this plugin&#10;2. Choose FITS, XISF or TIFF under Options -> Imaging -> File Settings&#10;3. Take an exposure with your Canon camera on NINA's native Canon driver&#10;4. NINA saves the frame in your selected format&#10;5. With &quot;Also save Canon RAW file&quot; on, the CR3/CR2 is saved as well"
                        Foreground="{DynamicResource PrimaryBrush}"
                        FontSize="10"
                        TextWrapping="Wrap"
                        LineHeight="16" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>

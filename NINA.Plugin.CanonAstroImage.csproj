<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>NINA.Plugin.CanonAstroImage</RootNamespace>
    <AssemblyName>NINA.Plugin.CanonAstroImage</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Local development only: `dotnet build -p:DeployToNina=true` copies the DLL into the NINA plugin folder. -->
    <DeployToNina Condition="'$(DeployToNina)' == ''">false</DeployToNina>
    <NinaPluginDir>$(LOCALAPPDATA)\NINA\Plugins\3.0.0\Canon</NinaPluginDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" />
  </ItemGroup>

  <!-- Exclude template folder from build -->
  <ItemGroup>
    <Compile Remove="nina.plugin.template\**" />
    <EmbeddedResource Remove="nina.plugin.template\**" />
    <Page Remove="nina.plugin.template\**" />
    <None Remove="nina.plugin.template\**" />
  </ItemGroup>

  <!-- Opt-in local deploy. Never runs on a plain `dotnet build` or in CI. -->
  <Target Name="DeployToNinaPluginFolder" AfterTargets="Build" Condition="'$(DeployToNina)' == 'true'">
    <MakeDir Directories="$(NinaPluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NinaPluginDir)" />
    <Message Importance="high" Text="Copied $(TargetFileName) to $(NinaPluginDir)" />
  </Target>
</Project>
